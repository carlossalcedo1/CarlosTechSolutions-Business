# Copy to deploy/.env and fill in. .env is gitignored — never commit real
# values. This is the only env template in the repo: `api` and `cloudflared`
# both run from deploy/.env (docker-compose.yml's `env_file`).
#
# To run the API alone, without compose, point it at this same file:
#   uvicorn backend.app.main:app --env-file deploy/.env
# and set SITE_URL=http://localhost:5173 while you do.
#
# deploy.sh refuses to deploy unless TUNNEL_TOKEN, STRIPE_SECRET_KEY,
# STRIPE_WEBHOOK_SECRET, RESEND_API_KEY and SITE_URL all have values. The
# rest are optional and documented below.
#
# Everything here is server-side. None of it is ever handed to the browser.

# ---------------------------------------------------------------------------
# Cloudflare tunnel
# ---------------------------------------------------------------------------
# Get this from: Cloudflare dashboard -> Zero Trust -> Networks -> Tunnels
#   -> create a tunnel (do NOT reuse promptworks-nuc's — see
#      docker-compose.yml's header for why this project gets its own)
#   -> Configure -> the token in the install command's Docker tab.
# Long base64-ish string starting with "eyJ". Treat it as a password.
#
# Left blank on purpose: deploy.sh checks for a non-empty value, so a
# placeholder here would sail past that guard and fail later inside compose.

TUNNEL_TOKEN=

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
# Dashboard -> Developers -> API keys. Use test keys (sk_test_...) until
# you're ready to accept real money.

STRIPE_SECRET_KEY=
# Created when you register this deployment's webhook URL in the Stripe
# dashboard (Developers -> Webhooks -> Add endpoint -> https://<this
# project's domain>/api/stripe-webhook). Not the same secret `stripe listen`
# prints locally — that one's only for local testing.
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Resend (email)
# ---------------------------------------------------------------------------

RESEND_API_KEY=
# Resend -> Audiences. Only needed for the new-listing mailing list.
RESEND_AUDIENCE_ID=
# Where contact/trade-in form notifications land.
NOTIFY_EMAIL=request@carlostechsolutions.com
# Where "Sold: X" alerts land — separate inbox on purpose, see
# backend/app/main.py. Needs its own Cloudflare Email Routing rule to
# actually receive mail, same as request@/inquiry@. Falls back to
# NOTIFY_EMAIL if left blank.
SALE_NOTIFY_EMAIL=sale@carlostechsolutions.com
# Optional — defaults to noreply@<SITE_URL's host> if left blank. Must be a
# domain verified in Resend either way.
FROM_EMAIL=

# ---------------------------------------------------------------------------
# Pushover (optional) — push alerts to your phone
# ---------------------------------------------------------------------------
# Fires the moment something sells, alongside the "Sold: X" email — see
# backend/app/notifier.py. Leave both blank and you just get the email.
#
# This is your personal Pushover account, which is why it can't be used for
# customer order confirmations: a recipient would need the app and their own
# license. Buyer confirmations stay email.
#
#   PUSHOVER_TOKEN     pushover.net -> Create an Application (name it
#                      CarlosTechSolutions)
#   PUSHOVER_USER_KEY  your user key, shown on the pushover.net dashboard
#
# Either one alone does nothing — notifier.py needs both to send.

PUSHOVER_TOKEN=
PUSHOVER_USER_KEY=

# ---------------------------------------------------------------------------
# Package tracking (Shippo) — the admin panel's Packages tab
#
# Shippo watches each tracking number and calls back on every scan; a
# delivery pushes to your phone through Pushover above.
#
#   SHIPPO_API_TOKEN      Shippo portal -> Settings -> API -> your *live* token
#   SHIPPO_WEBHOOK_TOKEN  make one up: a long random string, e.g. from
#                         `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`
#
# Then, in the Shippo portal (Settings -> API -> Webhooks -> Add webhook),
# add one webhook *before* tracking anything — Shippo only reports numbers
# registered after it exists:
#   Event type:  Track Updated
#   Environment: Production
#   URL:         https://<your site>/api/shippo-webhook?token=<SHIPPO_WEBHOOK_TOKEN>
#
# SHIPPO_MONTHLY_LIMIT caps registrations per month at Shippo's free
# allowance, so a busy month stops tracking instead of starting to cost.

SHIPPO_API_TOKEN=
SHIPPO_WEBHOOK_TOKEN=
SHIPPO_MONTHLY_LIMIT=

# ---------------------------------------------------------------------------
# Admin sign-in
# ---------------------------------------------------------------------------
# Who may ask for a login code at /login. Comma-separated, five at most.
# Blank means nobody can sign in — which is the right default, so don't put
# a placeholder name here.
#
# A bare username gets its code pushed to PUSHOVER_USER_KEY above, i.e. your
# own phone. That covers one admin and needs nothing else set.
#
#   ADMIN_USERNAMES=cmsal06
#
# A second admin needs their own Pushover user key appended after a colon,
# because Pushover delivers to a device, not to a username this app made up.
# They install Pushover, buy the one-time license, and send you the user key
# from their dashboard.
#
#   ADMIN_USERNAMES=cmsal06,sam:uQiZabc123def456ghi789
#
# Usernames are matched case-insensitively.

ADMIN_USERNAMES=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# The real public hostname for THIS deployment. Used for Stripe redirect
# URLs, CORS (backend/app/main.py locks CORS to exactly this), and the
# FROM_EMAIL fallback above. Must be the same hostname routed to this
# tunnel in the Cloudflare dashboard.

SITE_URL=https://shop.carlostechsolutions.com
