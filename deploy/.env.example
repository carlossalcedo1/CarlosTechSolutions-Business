# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# This is what `api` and `cloudflared` actually run with on the server.
# backend/.env is a separate file for local iteration (docker run
# --env-file backend/.env) — the two are not synced automatically.

# ---------------------------------------------------------------------------
# Cloudflare tunnel
# ---------------------------------------------------------------------------
# Get this from: Cloudflare dashboard -> Zero Trust -> Networks -> Tunnels
#   -> create a tunnel (do NOT reuse promptworks-nuc's — see
#      docker-compose.yml's header for why this project gets its own)
#   -> Configure -> the token in the install command's Docker tab.
# Long base64-ish string starting with "eyJ". Treat it as a password.

TUNNEL_TOKEN=paste-your-cloudflare-tunnel-token-here

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
# Dashboard -> Developers -> API keys. Test keys (sk_test_...) until Phase 3's
# "Then, to accept real money" section in LAUNCH_CHECKLIST.md is done.

STRIPE_SECRET_KEY=
# Created when you register this deployment's webhook URL in the Stripe
# dashboard (Developers -> Webhooks -> Add endpoint -> https://<this
# project's domain>/api/stripe-webhook). Not the same secret `stripe listen`
# prints locally — that one's only for local testing.
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Resend
# ---------------------------------------------------------------------------

RESEND_API_KEY=
RESEND_AUDIENCE_ID=
# Where contact/trade-in form notifications land.
NOTIFY_EMAIL=request@carlostechsolutions.com
# Where "Sold: X" alerts land — separate inbox on purpose, see
# backend/app/main.py. Needs its own Cloudflare Email Routing rule to
# actually receive mail, same as request@/inquiry@. Falls back to
# NOTIFY_EMAIL if left blank.
SALE_NOTIFY_EMAIL=sale@carlostechsolutions.com
# Optional — defaults to noreply@<SITE_URL's host> if left blank. Must be a
# domain verified in Resend either way.
FROM_EMAIL=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# The real public hostname for THIS deployment. Used for Stripe redirect
# URLs, CORS (backend/app/main.py locks CORS to exactly this), and the
# FROM_EMAIL fallback above. Must be the same hostname routed to this
# tunnel in the Cloudflare dashboard.

SITE_URL=https://shop.carlostechsolutions.com
