# Copy to backend/.env and fill in. That file is gitignored — see the root
# .gitignore and LAUNCH_CHECKLIST.md Phase 0. Never commit real values.
#
# Full description of each of these is in LAUNCH_CHECKLIST.md's
# "Environment variables" table.

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
RESEND_API_KEY=re_...
RESEND_AUDIENCE_ID=
NOTIFY_EMAIL=you@example.com
SITE_URL=http://localhost:5173

# Optional — defaults to noreply@<SITE_URL's host> if left blank. Must be a
# domain verified in Resend either way (see Phase 2).
FROM_EMAIL=
