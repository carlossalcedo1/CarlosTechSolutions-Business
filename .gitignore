# One .gitignore for the whole repo. frontend/ and deploy/ each used to
# carry their own; both are folded in here so there's a single place to look
# when something unexpectedly shows up in (or vanishes from) git status.
#
# Patterns without a slash match at every depth, which is why `.env` alone
# already covers backend/.env and deploy/.env.

# Secrets — never let these exist in git history
.env
.env.*
!.env.example
backend/.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Runtime data — sold-state store, subscriber list. Not source, and on the
# server it's a mounted volume anyway (see deploy/docker-compose.yml).
backend/data/

# Inventory — local to each computer by choice, never synced through git.
# Copy these two by hand to move inventory between machines or onto the
# server before a deploy (see docs/ADDING_INVENTORY.md). A fresh clone gets
# an empty catalog from frontend/scripts/ensure-catalog.mjs.
scripts/items.json
frontend/public/items/

# Node — these came from frontend/.gitignore (the Vite scaffold's defaults)
node_modules/
dist/
dist-ssr/
*.local
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS / editor cruft — also from the frontend scaffold. *.sw? supersedes the
# *.swp this file used to have, so vim's .swo/.swn are caught too.
.DS_Store
*.sw?
# **/ on purpose: a pattern containing a slash is anchored to the directory
# holding the .gitignore, so a bare `.vscode/*` here would only match one at
# the repo root — not frontend/.vscode/, which is what it covered before it
# was folded in from frontend/.gitignore.
**/.vscode/*
!**/.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
